# Database
DATABASE_URL=postgresql://blocklist:blocklist@localhost:5432/blocklist_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# API key trusted apps must send (X-Api-Key header)
API_KEY=change-me-in-production

# External blocklist source (StevenBlack porn-only hosts format)
EXTERNAL_BLOCKLIST_SOURCE=https://raw.githubusercontent.com/StevenBlack/hosts/master/alternates/porn-only/hosts

# Cron: update from external source daily at midnight
BLOCKLIST_CRON=0 0 * * *

# Sync worker interval on Android (hours)
PORT=3000
