<?xml version="1.0" encoding="utf-8"?>
<!-- Power button face: the gate mark itself, flat ink with quiet ripple -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#33F2EFE9">
    <item>
        <selector>
            <item android:state_pressed="true">
                <shape android:shape="oval">
                    <solid android:color="#26374A" />
                </shape>
            </item>
            <item>
                <shape android:shape="oval">
                    <solid android:color="#22333F" />
                </shape>
            </item>
        </selector>
    </item>
</ripple>
