<?xml version="1.0" encoding="utf-8"?>
<!-- Card: quiet surface, no border — separation comes from the surface
     contrast alone, so every screen speaks the same visual language -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/cardBg" />
    <corners android:radius="26dp" />
</shape>
