<?xml version="1.0" encoding="utf-8"?>
<!-- F2: idle halo — the gate waits under three quiet stepped layers of ink -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#0D26374A" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#1426374A" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#1E26374A" />
            <stroke android:width="1dp" android:color="#3326374A" />
        </shape>
    </item>
</layer-list>
