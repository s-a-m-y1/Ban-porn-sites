<?xml version="1.0" encoding="utf-8"?>
<!-- F2: active halo — the closed gate glows in three layered teal alphas -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#122F7A6B" />
        </shape>
    </item>
    <item android:left="4dp" android:top="4dp" android:right="4dp" android:bottom="4dp">
        <shape android:shape="oval">
            <solid android:color="#1E2F7A6B" />
        </shape>
    </item>
    <item android:left="10dp" android:top="10dp" android:right="10dp" android:bottom="10dp">
        <shape android:shape="oval">
            <solid android:color="#2E2F7A6B" />
            <stroke android:width="1dp" android:color="#4D2F7A6B" />
        </shape>
    </item>
</layer-list>
