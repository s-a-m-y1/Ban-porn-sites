<?xml version="1.0" encoding="utf-8"?>
<!-- F3: elevated sub-surface for the schedule time panel.
     Uses ?attr/cardBgElevated (the raised tier above ?attr/cardBg cards);
     1dp ?attr/strokeColor keeps it delineated in light mode where
     cardBg and cardBgElevated are both pure white. 16dp corners match
     the app's sub-surface idiom (chip_green / card_outlined). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/cardBgElevated" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="?attr/strokeColor" />
</shape>
