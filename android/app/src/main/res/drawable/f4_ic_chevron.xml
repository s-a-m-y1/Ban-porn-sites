<?xml version="1.0" encoding="utf-8"?>
<!-- F4: forward chevron for action rows (sits directly on the card, so it
     strokes textSecondary — visible in both light and night). The ImageView
     sets autoMirrored so it points with travel direction in RTL. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp" android:height="24dp"
    android:viewportWidth="24" android:viewportHeight="24">
    <path
        android:fillColor="#00000000"
        android:strokeColor="?attr/textSecondary"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:pathData="M9.2,5.2L15.6,12L9.2,18.8" />
</vector>
