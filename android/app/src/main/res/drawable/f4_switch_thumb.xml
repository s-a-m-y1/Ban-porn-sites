<?xml version="1.0" encoding="utf-8"?>
<!-- F4: SwitchCompat thumb — 16dp knob inside a 20dp box (2dp optical inset).
     Checked: onAccent (white on teal in light, ink on teal in night — the app's
     canonical accent pairing, Material dark-switch pattern).
     Unchecked: textSecondary (dark navy in light, parchment in night). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <layer-list>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <size android:width="16dp" android:height="16dp" />
                    <solid android:color="?attr/onAccent" />
                </shape>
            </item>
        </layer-list>
    </item>
    <item>
        <layer-list>
            <item android:left="2dp" android:top="2dp" android:right="2dp" android:bottom="2dp">
                <shape android:shape="oval">
                    <size android:width="16dp" android:height="16dp" />
                    <solid android:color="?attr/textSecondary" />
                </shape>
            </item>
        </layer-list>
    </item>
</selector>
