<?xml version="1.0" encoding="utf-8"?>
<!-- F6 · PIN dots · empty state: a quiet 2dp stroke in the theme line color.
     Resolves strokeColor per light/night, so the empty dot stays calm
     parchment-clay by day and slate by night. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="@android:color/transparent" />
    <stroke android:width="2dp" android:color="?attr/strokeColor" />
    <size android:width="16dp" android:height="16dp" />
</shape>
