<?xml version="1.0" encoding="utf-8"?>
<!-- F6 · PIN dots · filled state: the accent carries "captured".
     accentColor is teal by day and teal_night by night, so the filled dot
     reads warm-green on parchment and soft mint on ink. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="oval">
    <solid android:color="?attr/accentColor" />
    <size android:width="16dp" android:height="16dp" />
</shape>
