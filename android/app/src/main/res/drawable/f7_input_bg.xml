<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <!-- quiet input well on the ink surface: 12dp radius sits on the
         unified 8/12/16/24dp scale, 1dp stone stroke at ~24% alpha -->
