<?xml version="1.0" encoding="utf-8"?>
<!-- f9 unified chip family — resting state: theme surface tint (?attr/cardBg)
     with a hairline theme stroke (?attr/strokeColor), 16dp corners matching
     the unified chip_* family. Theme-aware in both light and dark. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/cardBg" />
    <corners android:radius="16dp" />
    <stroke android:width="1dp" android:color="?attr/strokeColor" />
</shape>
