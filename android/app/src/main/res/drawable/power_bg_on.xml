<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Outer glow -->
    <item>
        <shape android:shape="oval">
            <gradient android:type="radial" android:gradientRadius="90dp"
                android:startColor="#664CAF50" android:endColor="#004CAF50" />
        </shape>
    </item>
    <!-- Inner ring -->
    <item android:inset="14dp">
        <shape android:shape="oval">
            <solid android:color="#224CAF50" />
            <stroke android:width="2dp" android:color="#664CAF50" />
        </shape>
    </item>
</layer-list>
