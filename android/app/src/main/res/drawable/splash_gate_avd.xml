<?xml version="1.0" encoding="utf-8"?>
<!-- Two movements, like the reference video:
     1) the pen draws the arch — outer contour, then the inner one
     2) the drawn outline dissolves INTO the solid ring (fill crossfade) -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/ic_splash_outline">

    <!-- outer contour: one continuous stroke from the bottom-left leg,
         over the apex, down to the bottom-right leg -->
    <target android:name="outerOutline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0" android:valueTo="1"
                android:duration="750"
                android:interpolator="@android:interpolator/linear_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- inner contour joins while the outer is still settling -->
    <target android:name="innerOutline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="trimPathEnd"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="350"
                android:duration="650"
                android:interpolator="@android:interpolator/linear_out_slow_in" />
        </aapt:attr>
    </target>

    <!-- the outline becomes the mark: ring fills as the strokes retire -->
    <target android:name="ringSolid">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="fillAlpha"
                android:valueFrom="0" android:valueTo="1"
                android:startOffset="1300"
                android:duration="650"
                android:interpolator="@android:interpolator/decelerate_quad" />
        </aapt:attr>
    </target>

    <target android:name="outerOutline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="1" android:valueTo="0"
                android:startOffset="1400"
                android:duration="500" />
        </aapt:attr>
    </target>

    <target android:name="innerOutline">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:propertyName="strokeAlpha"
                android:valueFrom="1" android:valueTo="0"
                android:startOffset="1400"
                android:duration="500" />
        </aapt:attr>
    </target>
</animated-vector>
