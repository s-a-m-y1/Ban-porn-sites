<?xml version="1.0" encoding="utf-8"?>
<!-- Premium PIN gate: hidden input captures keystrokes, animated dots render them.
     Shakes on error, glows teal on success, auto-submits at 6 digits. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shield"
            android:background="@drawable/icon_circle_green"
            android:padding="16dp"
            android:contentDescription="@string/pin_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pin_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimary" />

        <TextView
            android:id="@+id/pinReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:maxWidth="420dp"
            android:textSize="14sp"
            android:textColor="?attr/textSecondary" />

        <!-- capture layer: a real-sized transparent field over the dots.
             Tiny 1dp "hidden" fields get the keypad refused by many IMEs;
             a full-width touch target with invisible text always opens it. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <LinearLayout
                android:id="@+id/dotsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center">

            <View
                android:id="@+id/dot1"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot2"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot3"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot4"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pin_dot_empty" />

            <View
                android:id="@+id/dot5"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pin_dot_empty"
                android:visibility="gone" />

            <View
                android:id="@+id/dot6"
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/pin_dot_empty"
                android:visibility="gone" />
        </LinearLayout>

        <!-- the capture field sits ON the dots: transparent text, real size.
             The keypad opens for it because it is a genuine visible editor. -->
        <EditText
            android:id="@+id/pinInput"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_gravity="center"
            android:background="@android:color/transparent"
            android:inputType="numberPassword"
            android:maxLength="6"
            android:imeOptions="actionDone"
            android:textColor="@android:color/transparent"
            android:cursorVisible="false"
            android:autofillHints=""
            android:importantForAccessibility="no" />
        </FrameLayout>

        <TextView
            android:id="@+id/pinError"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/pin_wrong"
            android:textSize="13sp"
            android:textColor="@color/clay"
            android:visibility="gone" />

        <Button
            android:id="@+id/pinConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="30dp"
            android:maxWidth="360dp"
            android:layout_gravity="center_horizontal"
            android:text="@string/pin_confirm"
            android:background="@drawable/btn_primary"
            android:textColor="?attr/onAccent"
            android:textStyle="bold" />
    </LinearLayout>
</ScrollView>
