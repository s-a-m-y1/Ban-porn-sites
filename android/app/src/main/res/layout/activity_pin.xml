<?xml version="1.0" encoding="utf-8"?>
<!-- F6 · PIN entry gate.
     A hidden capture field (pinInput) receives keypad digits; the dot row
     renders them with designed states: empty = stroke, filled = accent,
     error = clay, success = teal. The keypad is pinned LTR so 1-9,0 never
     mirrors in the RTL app. Auth flow in PinActivity is unchanged. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:id="@+id/pinIcon"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shield"
            android:background="@drawable/icon_circle_green"
            android:padding="16dp"
            android:contentDescription="@null" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimary"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/pinReason"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:gravity="center"
            android:textSize="14sp"
            android:textColor="?attr/textSecondary"
            android:layout_marginTop="8dp" />

        <!-- dots + the invisible capture field laid over them -->
        <FrameLayout
            android:id="@+id/dotsFrame"
            android:layout_width="wrap_content"
            android:layout_height="56dp"
            android:layout_marginTop="24dp">

            <LinearLayout
                android:id="@+id/dotsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center">

                <View
                    android:id="@+id/dot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/dot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/dot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/dot4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/dot5"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty"
                    android:visibility="gone" />

                <View
                    android:id="@+id/dot6"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- capture layer: a 1dp pure data sink for the on-screen keypad.
                 Never focusable, never opens the IME — the TextWatcher drives
                 the dots and the auto-verify at 6 digits. -->
            <EditText
                android:id="@+id/pinInput"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="@null"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@android:color/transparent"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="no"
                android:autofillHints="" />
        </FrameLayout>

        <!-- clay error: glyph + bold text, shown as one row -->
        <LinearLayout
            android:id="@+id/pinErrorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/f6_ic_error"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/pinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/pin_wrong"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/clay_text"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- on-screen keypad: LTR is pinned so 1-9,0 order never mirrors.
             64dp x 56dp keys = generous targets; IBM Plex digits. -->
        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:layoutDirection="ltr">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key1"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key2"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key3"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/key4"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key5"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="5"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key6"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="6"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/key7"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="7"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key8"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="8"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key9"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="9"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <View
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/key0"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <FrameLayout
                    android:id="@+id/keyBackspace"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:contentDescription="@string/delete">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/f6_ic_backspace"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/pinConfirm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_primary"
            android:text="@string/pin_confirm"
            android:textColor="?attr/onAccent"
            android:textStyle="bold"
            android:textAllCaps="false" />
    </LinearLayout>
</ScrollView>
