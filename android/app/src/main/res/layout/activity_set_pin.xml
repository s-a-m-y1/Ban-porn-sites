<?xml version="1.0" encoding="utf-8"?>
<!-- F6 · PIN creation / change.
     Two labeled dot rows (entry, confirm) rendered from two hidden capture
     fields (pinInput1, pinInput2) written by the shared on-screen keypad.
     Validation flow in SetPinActivity (watcher, save, showErr) unchanged. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="24dp">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:src="@drawable/ic_shield"
            android:background="@drawable/icon_circle_green"
            android:padding="16dp"
            android:contentDescription="@null" />

        <TextView
            android:id="@+id/setPinTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_create_title"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimary"
            android:layout_marginTop="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="420dp"
            android:gravity="center"
            android:text="@string/pin_create_hint"
            android:textSize="14sp"
            android:textColor="?attr/textSecondary"
            android:layout_marginTop="8dp" />

        <!-- entry group: label + dots + hidden capture field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_enter_new"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/textSecondary"
            android:layout_marginTop="24dp" />

        <FrameLayout
            android:id="@+id/entryDotsFrame"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:id="@+id/entryDotsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center">

                <View
                    android:id="@+id/entryDot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/entryDot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/entryDot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/entryDot4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/entryDot5"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty"
                    android:visibility="gone" />

                <View
                    android:id="@+id/entryDot6"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- capture layer: 1dp data sink for the on-screen keypad -->
            <EditText
                android:id="@+id/pinInput1"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="@null"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:textColor="@android:color/transparent"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="no"
                android:autofillHints="" />
        </FrameLayout>

        <!-- confirm group: label + dots + hidden capture field -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/pin_confirm_new"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="?attr/textSecondary"
            android:layout_marginTop="16dp" />

        <FrameLayout
            android:id="@+id/confirmDotsFrame"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:foreground="?attr/selectableItemBackground">

            <LinearLayout
                android:id="@+id/confirmDotsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_gravity="center">

                <View
                    android:id="@+id/confirmDot1"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/confirmDot2"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/confirmDot3"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/confirmDot4"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty" />

                <View
                    android:id="@+id/confirmDot5"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty"
                    android:visibility="gone" />

                <View
                    android:id="@+id/confirmDot6"
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/f6_pin_dot_empty"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- capture layer: 1dp data sink for the on-screen keypad -->
            <EditText
                android:id="@+id/pinInput2"
                android:layout_width="1dp"
                android:layout_height="1dp"
                android:layout_gravity="center"
                android:background="@null"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:imeOptions="actionDone"
                android:textColor="@android:color/transparent"
                android:cursorVisible="false"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:importantForAccessibility="no"
                android:autofillHints="" />
        </FrameLayout>

        <!-- clay error: glyph + bold text, shown as one row -->
        <LinearLayout
            android:id="@+id/setPinErrorRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/f6_ic_error"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/setPinError"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/clay_text"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- shared keypad: LTR pinned so 1-9,0 order never mirrors -->
        <LinearLayout
            android:id="@+id/keypad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:layoutDirection="ltr">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/key1"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key2"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="2"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key3"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="3"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/key4"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="4"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key5"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="5"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key6"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="6"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/key7"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="7"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key8"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="8"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/key9"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="9"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <View
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/key0"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:gravity="center"
                    android:text="0"
                    android:textSize="22sp"
                    android:fontFamily="@font/plex"
                    android:textColor="?attr/textPrimary" />

                <FrameLayout
                    android:id="@+id/keyBackspace"
                    android:layout_width="64dp"
                    android:layout_height="56dp"
                    android:layout_marginStart="4dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/f6_key_bg"
                    android:contentDescription="@string/delete">

                    <ImageView
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@drawable/f6_ic_backspace"
                        android:layout_gravity="center"
                        android:contentDescription="@null" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>

        <Button
            android:id="@+id/setPinSave"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:enabled="false"
            android:alpha="0.5"
            android:background="@drawable/btn_primary"
            android:text="@string/pin_save"
            android:textColor="?attr/onAccent"
            android:textStyle="bold"
            android:textAllCaps="false" />

        <TextView
            android:id="@+id/setPinCancel"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginTop="12dp"
            android:background="@null"
            android:text="@string/cancel"
            android:textSize="14sp"
            android:textColor="?attr/textSecondary" />
    </LinearLayout>
</ScrollView>
