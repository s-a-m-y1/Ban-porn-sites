<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="32dp">

    <ImageView
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_shield"
        android:background="@drawable/icon_circle_green"
        android:padding="16dp"
        android:contentDescription="@string/pin_create_title" />

    <TextView
        android:id="@+id/setPinTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/pin_create_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="?attr/textPrimary" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/pin_create_hint"
        android:textSize="14sp"
        android:textColor="?attr/textSecondary" />

    <EditText
        android:id="@+id/pinInput1"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="28dp"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:hint="@string/pin_enter_new"
        android:imeOptions="actionNext"
        android:autofillHints="" />

    <EditText
        android:id="@+id/pinInput2"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="12dp"
        android:inputType="numberPassword"
        android:maxLength="6"
        android:hint="@string/pin_confirm_new"
        android:imeOptions="actionDone"
        android:autofillHints="" />

    <TextView
        android:id="@+id/setPinError"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textSize="13sp"
        android:text="@string/pin_wrong"
        android:textColor="@color/clay"
        android:visibility="gone" />

    <Button
        android:id="@+id/setPinSave"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="20dp"
        android:text="@string/pin_save"
        android:background="@drawable/btn_primary"
        android:textColor="?attr/onAccent"
        android:textStyle="bold"
        android:enabled="false"
        android:alpha="0.5" />

    <Button
        android:id="@+id/setPinCancel"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:text="@string/cancel"
        android:background="@android:color/transparent"
        android:textColor="?attr/textSecondary" />
</LinearLayout>
