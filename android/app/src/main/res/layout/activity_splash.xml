<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/splash_bg">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_gravity="center">

        <!-- gate mark, layered: outline (traces) -> solid body -> slit -->
        <FrameLayout
            android:layout_width="150dp"
            android:layout_height="150dp">

            <ImageView
                android:id="@+id/splashOutline"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/app_name" />

            <ImageView
                android:id="@+id/splashSolid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_splash_solid" />

            <ImageView
                android:id="@+id/splashSlit"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/ic_splash_slit" />
        </FrameLayout>

        <TextView
            android:id="@+id/splashTitleAr"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:text="@string/app_name_ar"
            android:textSize="42sp"
            android:textColor="@color/parchment"
            android:fontFamily="@font/cairo_extrabold"
            android:letterSpacing="0.02" />

        <TextView
            android:id="@+id/splashTitleEn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/app_name_latin"
            android:textSize="13sp"
            android:textColor="@color/stone_light"
            android:fontFamily="@font/plex_semibold"
            android:letterSpacing="0.35" />
    </LinearLayout>
</FrameLayout>
