<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ HERO: the gate is the product ============ -->
        <!-- one display-level focal point: the button. everything else is support. -->
        <LinearLayout
            android:id="@+id/heroContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hero_card"
            android:paddingStart="@dimen/hero_padding_h"
            android:paddingEnd="@dimen/hero_padding_h"
            android:paddingTop="@dimen/hero_padding_v"
            android:paddingBottom="@dimen/hero_padding_v">

            <!-- personalised greeting: ambient context, deliberately quiet -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_bold" />

            <!-- journey chip: "Day N of your journey" -->
            <TextView
                android:id="@+id/journeyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/journey_chip"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/brass_deep"
                android:fontFamily="@font/cairo_bold"
                android:visibility="gone"
                tools:text="اليوم ٣ من رحلتك" />

            <!-- status line -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_off" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/status_off"
                    android:textSize="14sp"
                    android:textColor="?attr/textSecondary"
                    android:fontFamily="@font/cairo_regular" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="@string/status_off_subtitle"
                android:textSize="@dimen/status_subtitle_size"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?attr/textSecondary"
                android:fontFamily="@font/cairo_regular" />

            <!-- the gate: layered halo, ink face, hairline rims -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gate_margin_top">

                <View
                    android:id="@+id/powerHalo"
                    android:layout_width="@dimen/gate_halo_size"
                    android:layout_height="@dimen/gate_halo_size"
                    android:layout_gravity="center"
                    android:background="@drawable/f2_halo_off" />

                <ImageButton
                    android:id="@+id/powerButton"
                    android:layout_width="@dimen/gate_button_size"
                    android:layout_height="@dimen/gate_button_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gate"
                    android:background="@drawable/f2_btn_gate"
                    android:scaleType="centerInside"
                    android:padding="@dimen/gate_button_inset"
                    android:elevation="0dp"
                    android:contentDescription="@string/start_blocking" />
            </FrameLayout>

            <TextView
                android:id="@+id/powerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/power_label_margin_top"
                android:text="@string/start_blocking"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_bold" />
        </LinearLayout>

        <!-- ============ THE REMINDER: hadith, right under the gate ============ -->
        <!-- at the moment of temptation the reminder is the closest thing to the eye -->
        <LinearLayout
            android:id="@+id/hadithCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/hadith_card_bg"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:id="@+id/hadithTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hadith_card_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/hadith_card_title"
                android:fontFamily="@font/cairo_bold" />

            <TextView
                android:id="@+id/hadithText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="@dimen/hadith_text_size"
                android:lineSpacingMultiplier="1.75"
                android:textColor="@color/parchment"
                android:fontFamily="@font/amiri" />
        </LinearLayout>

        <!-- ============ LIVE NUMBERS: two quiet typographic stats ============ -->
        <LinearLayout
            android:id="@+id/statsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/cardBg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/blockedCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                tools:text="52"
                    android:textSize="@dimen/stat_value_size"
                    android:fontFamily="@font/plexmono_semibold"
                    android:textColor="@color/clay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/blocked_count"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary"
                    android:fontFamily="@font/cairo_regular" />
            </LinearLayout>

            <!-- thin stone-light divider between the two numbers -->
            <View
                android:layout_width="1dp"
                android:layout_height="48dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/strokeColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/statsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                tools:text="166637"
                    android:textSize="@dimen/stat_value_size"
                    android:fontFamily="@font/plexmono_semibold"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/blocklist_size"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary"
                    android:fontFamily="@font/cairo_regular" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ HOW THE GATE WORKS: three steps, quiet ============ -->
        <LinearLayout
            android:id="@+id/stepsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <!-- demoted section header: a quiet green label above the steps -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_it_works_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/green_light"
                android:fontFamily="@font/cairo_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/how_it_works_body"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/textSecondary"
                android:fontFamily="@font/cairo_regular" />

            <!-- step 1: one tap -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    style="@style/IconCircle"
                    android:background="@drawable/icon_circle_green">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/f2_ic_step_tap"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_1_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal"
                        android:fontFamily="@font/cairo_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_1_body"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="?attr/textSecondary"
                        android:fontFamily="@font/cairo_regular" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="?attr/strokeColor" />

            <!-- step 2: one question -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    style="@style/IconCircle"
                    android:background="@drawable/icon_circle_green">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/f2_ic_step_scan"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_2_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal"
                        android:fontFamily="@font/cairo_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_2_body"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="?attr/textSecondary"
                        android:fontFamily="@font/cairo_regular" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="56dp"
                android:background="?attr/strokeColor" />

            <!-- step 3: one answer -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <FrameLayout
                    style="@style/IconCircle"
                    android:background="@drawable/icon_circle_green">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/f2_ic_step_shield"
                        android:importantForAccessibility="no" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="14dp"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/step_3_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/teal"
                        android:fontFamily="@font/cairo_bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/step_3_body"
                        android:textSize="13sp"
                        android:lineSpacingMultiplier="1.5"
                        android:textColor="?attr/textSecondary"
                        android:fontFamily="@font/cairo_regular" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ============ TRUST ============ -->
        <LinearLayout
            android:id="@+id/trustCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/cardBg"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trust_title"
                android:textSize="12sp"
                android:textStyle="bold"
                android:textColor="@color/green_light"
                android:fontFamily="@font/cairo_bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/trust_body"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/textSecondary"
                android:fontFamily="@font/cairo_regular" />
        </LinearLayout>

        <!-- ============ FOOTER ============ -->
        <LinearLayout
            android:id="@+id/footerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hero_card"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="32dp"
            android:paddingBottom="36dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_gate"
                android:tint="?attr/textPrimary"
                android:contentDescription="@string/app_name_ar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/app_name_ar"
                android:textSize="15sp"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_extrabold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/app_name_latin"
                android:textSize="10sp"
                android:textColor="@color/stone_deep"
                android:fontFamily="@font/plex_semibold"
                android:letterSpacing="0.35" />

            <Button
                android:id="@+id/emailButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="24dp"
                android:minWidth="220dp"
                android:text="@string/email_button"
                android:background="@drawable/btn_primary"
                android:textColor="?attr/onAccent"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:gravity="center"
                android:text="@string/powered_by"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/stone_deep" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
