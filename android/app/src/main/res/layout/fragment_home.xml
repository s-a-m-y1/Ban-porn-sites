<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- ============ HERO: the gate ============ -->
        <LinearLayout
            android:id="@+id/heroContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hero_card"
            android:paddingStart="@dimen/hero_padding_h"
            android:paddingEnd="@dimen/hero_padding_h"
            android:paddingTop="@dimen/hero_padding_v"
            android:paddingBottom="@dimen/hero_padding_v">

            <!-- personalised greeting: time of day + the user's name -->
            <TextView
                android:id="@+id/greetingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_extrabold" />

            <!-- journey chip: "Day N of your journey" -->
            <TextView
                android:id="@+id/journeyChip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/journey_chip"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                android:textColor="@color/brass"
                android:visibility="gone"
                tools:text="اليوم ٣ من رحلتك" />

            <!-- status line -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <View
                    android:id="@+id/statusDot"
                    android:layout_width="8dp"
                    android:layout_height="8dp"
                    android:background="@drawable/status_dot_off" />

                <TextView
                    android:id="@+id/statusText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/status_off"
                    android:textSize="14sp"
                    android:textColor="?attr/textSecondary" />
            </LinearLayout>

            <TextView
                android:id="@+id/statusSubtitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:text="@string/status_off_subtitle"
                android:textSize="@dimen/status_subtitle_size"
                android:lineSpacingMultiplier="1.4"
                android:textColor="?attr/textSecondary"
                android:fontFamily="@font/cairo_regular" />

            <!-- the gate: halo + power button -->
            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/gate_margin_top">

                <View
                    android:id="@+id/powerHalo"
                    android:layout_width="@dimen/gate_halo_size"
                    android:layout_height="@dimen/gate_halo_size"
                    android:layout_gravity="center"
                    android:background="@drawable/power_bg_off" />

                <ImageButton
                    android:id="@+id/powerButton"
                    android:layout_width="@dimen/gate_button_size"
                    android:layout_height="@dimen/gate_button_size"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_gate"
                    android:background="@drawable/btn_gate"
                    android:scaleType="centerInside"
                    android:padding="@dimen/gate_button_inset"
                    android:elevation="0dp"
                    android:contentDescription="@string/start_blocking" />
            </FrameLayout>

            <TextView
                android:id="@+id/powerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/power_label_margin_top"
                android:text="@string/start_blocking"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_bold" />
        </LinearLayout>

        <!-- ============ THE REMINDER: hadith, right under the gate ============ -->
        <!-- at the moment of temptation the reminder is the closest thing to the eye -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/hadith_card_bg"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="26dp"
            android:paddingBottom="26dp">

            <TextView
                android:id="@+id/hadithTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hadith_card_title"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:textColor="@color/hadith_card_title" />

            <TextView
                android:id="@+id/hadithText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:textSize="@dimen/hadith_text_size"
                android:lineSpacingMultiplier="1.75"
                android:textColor="@color/parchment"
                android:fontFamily="@font/amiri" />
        </LinearLayout>

        <!-- ============ LIVE NUMBERS: two quiet typographic stats ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="?attr/cardBg"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/blockedCountText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                tools:text="52"
                android:textSize="@dimen/stat_value_size"
                    android:fontFamily="@font/plexmono_semibold"
                    android:textColor="@color/clay" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/blocked_count"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary" />
            </LinearLayout>

            <!-- thin stone-light divider between the two numbers -->
            <View
                android:layout_width="1dp"
                android:layout_height="52dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/strokeColor" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/statsText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                tools:text="166637"
                android:textSize="@dimen/stat_value_size"
                    android:fontFamily="@font/plexmono_semibold"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/blocklist_size"
                    android:textSize="12sp"
                    android:textColor="?attr/textSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ HOW THE GATE WORKS: three steps, quiet ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/how_it_works_title"
                android:textSize="20sp"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_extrabold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/how_it_works_body"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/textSecondary"
                android:fontFamily="@font/cairo_regular" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingBottom="36dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_1_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/step_1_body"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/textSecondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/strokeColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_2_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/step_2_body"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/textSecondary" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="?attr/strokeColor" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/step_3_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="@color/teal" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:text="@string/step_3_body"
                    android:textSize="13sp"
                    android:lineSpacingMultiplier="1.5"
                    android:textColor="?attr/textSecondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============ TRUST ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="?attr/cardBg"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="32dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/trust_title"
                android:textSize="20sp"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_extrabold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/trust_body"
                android:textSize="13sp"
                android:lineSpacingMultiplier="1.6"
                android:textColor="?attr/textSecondary"
                android:fontFamily="@font/cairo_regular" />
        </LinearLayout>

        <!-- ============ FOOTER ============ -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/hero_card"
            android:paddingStart="28dp"
            android:paddingEnd="28dp"
            android:paddingTop="34dp"
            android:paddingBottom="36dp">

            <ImageView
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:src="@drawable/ic_gate"
                android:tint="?attr/textPrimary"
                android:contentDescription="@string/app_name_ar" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/app_name_ar"
                android:textSize="17sp"
                android:textColor="?attr/textPrimary"
                android:fontFamily="@font/cairo_extrabold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="@string/app_name_latin"
                android:textSize="10sp"
                android:textColor="@color/stone"
                android:fontFamily="@font/plex_semibold"
                android:letterSpacing="0.35" />

            <Button
                android:id="@+id/emailButton"
                android:layout_width="wrap_content"
                android:layout_height="46dp"
                android:layout_marginTop="20dp"
                android:minWidth="220dp"
                android:text="@string/email_button"
                android:background="@drawable/btn_primary"
                android:textColor="?attr/onAccent"
                android:textStyle="bold"
                android:textAllCaps="false"
                android:stateListAnimator="@null" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:gravity="center"
                android:text="@string/powered_by"
                android:textSize="11sp"
                android:lineSpacingMultiplier="1.5"
                android:textColor="@color/stone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
