<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="6dp"
            android:text="@string/tab_stats"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="?attr/textPrimary" />

        <!-- WEEKLY REPORT CARD -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/card_bg"
            android:padding="18dp"
            android:layout_marginTop="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <FrameLayout style="@style/IconCircle"
                    android:background="@drawable/icon_circle_red">
                    <ImageView android:layout_width="22dp" android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_block" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="@string/report_title"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="?attr/textPrimary" />

                <TextView
                    android:id="@+id/reportCount"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/green_light"
                    android:textStyle="bold"
                    android:textSize="15sp" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_desc"
                android:textSize="13sp"
                android:textColor="?attr/textSecondary" />

            <LinearLayout android:id="@+id/reportBars"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom"
                android:layout_marginTop="16dp" />

            <TextView
                android:id="@+id/heatmapSelected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp"
                android:text="@string/heatmap_today"
                android:textSize="12sp"
                android:textColor="?attr/textSecondary" />

            <com.contentfilter.app.HeatmapView
                android:id="@+id/heatmap"
                android:layout_width="match_parent"
                android:layout_height="140dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
