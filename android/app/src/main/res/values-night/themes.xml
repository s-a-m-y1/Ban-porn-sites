<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.ContentFilter" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- keep Cairo at night: without these two items the DayNight parent
             resolves the font reference per-configuration and text falls back
             to Roboto in dark mode. Mirrors the base theme's first items. -->
        <item name="android:fontFamily">@font/cairo</item>
        <item name="fontFamily">@font/cairo</item>
        <item name="colorPrimary">@color/teal</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/teal_accent</item>
        <item name="colorSurface">@color/bg_dark_surface</item>
        <item name="android:colorBackground">@color/bg_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/bg_dark_surface</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="cardBg">@color/bg_dark_surface</item>
        <item name="cardBgElevated">@color/bg_dark_elevated</item>
        <item name="textPrimary">@color/text_primary_dark</item>
        <item name="textSecondary">@color/text_secondary_dark</item>
        <item name="dividerColor">@color/divider_dark</item>
        <item name="strokeColor">@color/stroke_dark</item>
        <item name="accentColor">@color/teal_accent</item>
        <item name="onAccent">@color/bg_dark</item>
        <item name="colorControlHighlight">@color/green_12</item>
        <item name="android:textColorHighlight">@color/green_12</item>
        <item name="heroBg">@color/bg_dark</item>
    </style>

    <style name="NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/green_12</item>
    </style>

    <style name="NavTextActive">
        <item name="android:textSize">10sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NavTextInactive">
        <item name="android:textSize">10sp</item>
    </style>
</resources>
