    <string name="how_it_works_title">How the gate works</string>
    <string name="how_it_works_body">Hisn stands quietly between your device and the web. Every site you visit passes through one question: is this address on the block list? Nothing more, nothing less.</string>
    <string name="step_1_title">One tap</string>
    <string name="step_1_body">Open the gate or close it. Protection starts with a single press.</string>
    <string name="step_2_title">One question</string>
    <string name="step_2_body">Each site request is checked against a local block list on your device.</string>
    <string name="step_3_title">One answer</string>
    <string name="step_3_body">Blocked addresses never leave your phone. Allowed ones pass untouched.</string>
    <string name="trust_title">Private by construction</string>
    <string name="trust_body">The list lives on your device. Filtering happens locally, in silence. We do not see your browsing, we do not collect it, and there is nothing to sell.</string>
    <string name="powered_by">Powered by local DNS filtering — no data leaves your device.</string>

