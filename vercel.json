{
  "buildCommand": "cd website-v2 && npm install && npm run build",
  "outputDirectory": "website-v2/dist",
  "installCommand": "echo skip",
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
